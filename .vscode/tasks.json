{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build PingPongGame",
            "type": "shell",
            "command": "g++",
            "args": [
                "-std=c++17",
                "-I.",
                "./src/*.cpp",
                "-o",
                "PingPongGame",
                "-lraylib",
                "-lm",
                "-lpthread",
                "-lwinmm",
                "-lgdi32"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "type": "cppbuild",
            "label": "C/C++: g++.exe build active file",
            "command": "C:\\mingw64\\bin\\g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build",
            "detail": "Task generated by Debugger."
        }
    ]
}